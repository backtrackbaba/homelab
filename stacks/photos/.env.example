TZ=Asia/Kolkata

DATA_ROOT=/Users/sai-mini/homelab/data

# Host-visible upload location for original photos/videos. Bind mount, not
# a Docker named volume, so originals stay migratable and inspectable.
UPLOAD_LOCATION=${DATA_ROOT}/immich/upload

# Immich's dedicated Postgres. Never the homelab core Postgres.
DB_DATA_LOCATION=${DATA_ROOT}/appdata/immich/database

BIND_ADDRESS=0.0.0.0

# Pin explicitly; read release notes before bumping. Do not use "release".
IMMICH_VERSION=v3.1.0

# Real value lives in secrets.enc.env at the repo root (IMMICH_DB_PASSWORD).
# This placeholder is only here so `docker compose config` has something to
# substitute when validating the file without secrets decrypted.
DB_PASSWORD=changeme
DB_USERNAME=immich
DB_DATABASE_NAME=immich

# Conservative for a 24GB machine that also runs LM Studio and Jellyfin.
# Revisit after Phase 5 observation once real usage is measured.
MACHINE_LEARNING_WORKERS=1
MACHINE_LEARNING_REQUEST_THREADS=2
