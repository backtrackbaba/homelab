TZ=Asia/Kolkata
PUID=501
PGID=20

# Shared with the core stack's DATA_ROOT so everything lives under one
# migratable root. Change only this line to move all bulk data later
# (e.g. to /Volumes/media-pool once external storage is added).
DATA_ROOT=/Users/sai-mini/homelab/data

# Per-app config/state (small, stays on the internal SSD even after
# MEDIA_ROOT/DOWNLOAD_ROOT move to external storage).
APPDATA_ROOT=${DATA_ROOT}/appdata/media

# Final media library. Must be on the same filesystem as DOWNLOAD_ROOT
# for the Arr stack + qBittorrent to hardlink instead of copy.
MEDIA_ROOT=${DATA_ROOT}/media

# In-progress and completed downloads before the Arr stack imports them.
DOWNLOAD_ROOT=${DATA_ROOT}/downloads

# LAN + Tailscale reachable, no router port forwarding. Not restricted to
# 127.0.0.1 because these UIs are administered from other machines on the
# LAN/tailnet, not just the Mac mini itself.
BIND_ADDRESS=0.0.0.0

QBITTORRENT_WEBUI_PORT=8090
