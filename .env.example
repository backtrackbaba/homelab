TZ=Asia/Kolkata
PUID=501
PGID=20

# Persistent container data is centralized here, separate from the Git repo.
DATA_ROOT=/Users/Shared/homelab/data
# Dockge-managed Compose stacks are centralized here.
STACKS_ROOT=/Users/Shared/homelab/stacks


# Use 0.0.0.0 initially. Later this can be restricted after validating
# Docker Desktop and Tailscale routing on the Mac mini.
BIND_ADDRESS=0.0.0.0
ADMIN_BIND_ADDRESS=127.0.0.1

POSTGRES_ADMIN_USER=homeserver_admin
POSTGRES_ADMIN_DB=homeserver
N8N_DB_USER=n8n
N8N_DB_NAME=n8n

BASE_DOMAIN=home.saiprasad.io
HOMEPAGE_HOST=home.saiprasad.io
N8N_HOST=n8n.home.saiprasad.io
NTFY_HOST=ntfy.home.saiprasad.io
SPEEDTEST_HOST=speedtest.home.saiprasad.io
UPTIME_HOST=uptime.home.saiprasad.io
DOZZLE_HOST=logs.home.saiprasad.io
DOCKGE_HOST=dockge.home.saiprasad.io
NPM_HOST=proxy.home.saiprasad.io
